# Production uses Supabase directly. Never expose the secret key to the frontend.
DATA_SOURCE=supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Generate a long random value and keep it identical across all backend functions.
ROSTER_SESSION_SECRET=GENERATE_A_LONG_RANDOM_SECRET
ROSTER_SECURE_COOKIES=1

# Comma-separated exact frontend origins. Do not include a trailing slash.
CORS_ORIGINS=http://localhost:5173,https://YOUR_FRONTEND.vercel.app

# Optional: enable Vercel preview URLs. Keep the expression anchored.
# CORS_ORIGIN_REGEX=^https://[a-z0-9-]+-YOUR_TEAM\.vercel\.app$
